# Copy to .env.local and fill in. Never commit a filled copy.
# Documented in docs/14-tech-stack.md

# ---------- data ----------
DATABASE_URL=postgresql://hydroponer:hydroponer@localhost:5432/hydroponer
REDIS_URL=redis://localhost:6379

# ---------- object storage (S3-compatible; MinIO locally) ----------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=hydroponer-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ---------- models ----------
ANTHROPIC_API_KEY=
MODEL_SCENE_ANALYSIS=claude-opus-5
MODEL_NARRATION=claude-sonnet-5
PROMPT_VERSION=1.0.0

# ---------- depth service ----------
DEPTH_SERVICE_URL=http://localhost:8000

# ---------- pricing ----------
FX_API_KEY=
CATALOG_VERSION=2026.04.1

# ---------- auth ----------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------- pipeline behaviour ----------
# true replays recorded fixtures instead of calling live models. Keep true
# for day-to-day development; live calls cost money.
FIXTURE_MODE=true
MAX_JOB_SECONDS=180
MAX_IMAGE_BYTES=15728640
CONFIDENCE_GATE_THRESHOLD=0.7

# ---------- limits ----------
RATE_LIMIT_ANON_PER_DAY=3
RATE_LIMIT_USER_PER_DAY=10

# ---------- retention ----------
PHOTO_RETENTION_DAYS=90
ANON_SPACE_RETENTION_DAYS=30

# ---------- 3D viewer ----------
# CDN origin serving the glTF part library. Empty uses the local /models route.
MODEL_LIBRARY_CDN=
SCENE_MAX_NODES=2000

# ---------- observability ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- public (exposed to the browser; nothing sensitive) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_3D=true
