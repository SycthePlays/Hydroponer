# dependencies
node_modules/
.pnpm-store/

# build output
# Anchored on purpose: a bare "build/" or "dist/" also matches a Next.js
# route segment such as app/designs/[id]/build, and silently drops the page.
/build/
/dist/
apps/*/build/
apps/*/dist/
packages/*/build/
packages/*/dist/
.next/
out/
*.tsbuildinfo

# python (depth service)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# environment
.env
.env.local
.env.*.local
!.env.example

# test and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# evaluation artefacts
evals/runs/
evals/reports/

# model fixtures are committed; recorded raw responses are not
fixtures/raw/

# user data must never be committed
**/user-photos/
**/golden-set/images/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors and OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# local infrastructure
docker-compose.override.yml
.data/
